# BharatData — environment template. Copy to .env and fill in. Never commit .env.

# data.gov.in personal API key (free: log in at https://data.gov.in >
# My Account > API key). The public sample key returns max 10 records and
# is only good for trying the portal by hand — real ingestion needs this.
DATA_GOV_IN_API_KEY=

# Public domain for Caddy (leave as :80 for IP-only HTTP mode on the VM)
DOMAIN=:80

# Postgres (matches docker-compose.yml service names)
POSTGRES_DB=bharatdata
POSTGRES_USER=bharatdata
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://bharatdata:change-me@postgres:5432/bharatdata

# Redis (cache + rate-limit counters + queues)
REDIS_URL=redis://redis:6379/0

# Where the immutable raw zone lives inside the containers
BHARATDATA_RAW_DIR=/data/raw
